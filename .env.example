# Production: Nominatim-compatible provider or a shared proxy enforcing its quota.
# Local development falls back to public Nominatim, limited to one request/1.1s.
GEOCODING_BASE_URL=

# Keep the default Nominatim service on Vercel by connecting shared Redis.
# Server-only credentials. All deployments must use the SAME database.
# KV_REST_API_URL / KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
